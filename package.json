{
  "name": "java-trainer",
  "version": "1.0.0",
  "description": "Тренажёр по Java + Spring Boot + Hibernate",
  "author": "Java Trainer",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "package:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:all": "electron-vite build && electron-builder -mw --publish never"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@uiw/codemirror-theme-github": "^4.23.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@uiw/react-codemirror": "^4.23.6",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^31.7.5",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.javatrainer.app",
    "productName": "Java Trainer",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.education",
      "identity": null
    }
  }
}
